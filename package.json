{
  "name": "@popcomputer/structured-chat",
  "version": "0.4.0",
  "description": "Schema-defined structured chats with typed tools, stages, and UI views",
  "type": "module",
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js"
    },
    "./model/openai-compatible": {
      "types": "./dist/model/openai-compatible.d.ts",
      "import": "./dist/model/openai-compatible.js"
    },
    "./model/cloudflare-workers-ai": {
      "types": "./dist/model/cloudflare-workers-ai.d.ts",
      "import": "./dist/model/cloudflare-workers-ai.js"
    },
    "./d1": {
      "types": "./dist/integrations/d1.d.ts",
      "import": "./dist/integrations/d1.js"
    },
    "./assistant-ui": {
      "types": "./dist/integrations/assistant-ui.d.ts",
      "import": "./dist/integrations/assistant-ui.js"
    },
    "./assistant-ui/debug": {
      "types": "./dist/integrations/assistant-ui-debug.d.ts",
      "import": "./dist/integrations/assistant-ui-debug.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "migrations/d1",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "check": "bun run check:architecture && tsc --noEmit && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.examples.json && tsc -p tsconfig.cloudflare-tests.json",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "oxlint .",
    "test": "bun test",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "test:node": "bun run build && node tests/node-esm-smoke.mjs",
    "test:package:types": "tsc -p tsconfig.package-tests.json",
    "test:package": "bun run build && bun run test:package:types && node tests/node-esm-smoke.mjs && npm pack --dry-run --ignore-scripts --offline --cache node_modules/.cache/npm",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "verify": "bun run lint && bun run check && bun test && bun run test:cloudflare && bun run test:package",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify"
  },
  "keywords": [
    "chat",
    "assistant-ui",
    "effect",
    "effect-ts",
    "popcomputer",
    "structured-output",
    "tool-calling",
    "workflow"
  ],
  "author": "Patrick Ogilvie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickOgilvie/popcomputer-structured-chat.git"
  },
  "homepage": "https://github.com/PatrickOgilvie/popcomputer-structured-chat#readme",
  "bugs": {
    "url": "https://github.com/PatrickOgilvie/popcomputer-structured-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@assistant-ui/core": "^0.3.1",
    "react": "^18.0.0 || ^19.0.0",
    "effect": "^4.0.0-rc.109"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/core": "0.3.13",
    "@assistant-ui/react": "^0.15.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "effect": "4.0.0-rc.109",
    "oxlint": "1.78.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-test-renderer": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
